{
  "respectGitignore": false,
  "cleanupPeriodDays": 7,
  "skillListingMaxDescChars": 2048,
  "skillListingBudgetFraction": 0.05,
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "true",
    "DISABLE_ERROR_REPORTING": "true",
    "DISABLE_MICROCOMPACT": "false",
    "CLAUDE_CODE_WORKFLOWS": "true",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "true",
    "ENABLE_LSP_TOOL": "true",
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "true",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "true",
    "CLAUDE_CODE_HIDE_ACCOUNT_INFO": "true",
    "DISABLE_TELEMETRY": "true",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5",
    "FORCE_AUTOUPDATE_PLUGINS": "true",
    "CLAUDE_CODE_ENABLE_TASKS": "true",
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "true",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "true",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "true",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(basedpyright:*)",
      "Bash(mypy:*)",
      "Bash(pyright:*)",
      "Bash(ruff:*)",
      "Bash(pytest:*)",
      "Bash(python:*)",
      "Bash(uv:*)",
      "Bash(go:*)",
      "Bash(gofumpt:*)",
      "Bash(goimports:*)",
      "Bash(golangci-lint:*)",
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(vitest:*)",
      "Bash(tsc:*)",
      "Bash(eslint:*)",
      "Bash(prettier:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(kubectl:*)",
      "Bash(helm:*)",
      "Bash(kind:*)",
      "Bash(stern:*)",
      "Bash(terraform:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(make:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(mkdir:*)",
      "Bash(cat:*)",
      "Bash(bat:*)",
      "Bash(eza:*)",
      "Bash(delta:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(curl:*)",
      "Bash(wc:*)",
      "Bash(tree:*)",
      "Edit",
      "Glob",
      "Grep",
      "NotebookEdit",
      "Read",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "Write",
      "LSP"
    ],
    "deny": [],
    "defaultMode": "bypassPermissions"
  },
  "enableAllProjectMcpServers": true,
  "skillOverrides": {
    "batch": "user-invocable-only",
    "claude-api": "user-invocable-only",
    "dataviz": "user-invocable-only",
    "debug": "user-invocable-only",
    "design": "user-invocable-only",
    "design-sync": "user-invocable-only",
    "doctor": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "init": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "loop": "user-invocable-only",
    "run": "user-invocable-only",
    "run-skill-generator": "user-invocable-only",
    "schedule": "user-invocable-only",
    "security-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "update-config": "user-invocable-only",
    "verify": "user-invocable-only",
    "workflow-authoring": "user-invocable-only"
  },
  "autoCompactWindow": 200000,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/.claude/scripts/patch-gopls-lsp.sh\""
          }
        ]
      },
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/.claude/scripts/compact-anchor.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/.claude/scripts/guard-bash.sh\" || exit 2"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'FILE=$(jq -r \".tool_input.file_path // empty\"); if [ -z \"$FILE\" ]; then exit 0; fi; case \"$FILE\" in *.py) ruff format --quiet \"$FILE\" 2>/dev/null ;; *.go) gofumpt -w \"$FILE\" 2>/dev/null ;; *.ts|*.tsx|*.js|*.jsx) prettier --write --log-level silent \"$FILE\" 2>/dev/null ;; esac; exit 0'"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/.claude/scripts/edit-lint.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/dotfiles/.claude/scripts/statusline.sh\"",
    "padding": 0
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@chrome-devtools-plugins": true,
    "basedpyright@claude-code-lsps": true,
    "gopls@claude-code-lsps": true,
    "vtsls@claude-code-lsps": true,
    "webapp-testing@awesome-claude-skills": false,
    "github-automation@awesome-claude-skills": false,
    "slack-automation@awesome-claude-skills": false,
    "sentry-automation@awesome-claude-skills": false,
    "datadog-automation@awesome-claude-skills": false,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    },
    "claude-code-lsps": {
      "source": {
        "source": "github",
        "repo": "Piebald-AI/claude-code-lsps"
      }
    }
  },
  "outputStyle": "default",
  "viewMode": "verbose",
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "prefersReducedMotion": true,
  "autoDreamEnabled": false,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "verbose": true,
  "preferredNotifChannel": "auto",
  "showTurnDuration": true,
  "terminalProgressBarEnabled": true,
  "showThinkingHint": true,
  "model": "claude-fable-5-1"
}
