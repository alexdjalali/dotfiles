{
  "respectGitignore": false,
  "cleanupPeriodDays": 7,
  "skillListingMaxDescChars": 2048,
  "skillListingBudgetFraction": 0.05,
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "true",
    "DISABLE_ERROR_REPORTING": "true",
    "DISABLE_MICROCOMPACT": "false",
    "CLAUDE_CODE_WORKFLOWS": "true",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "true",
    "ENABLE_LSP_TOOL": "true",
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "true",
    "CLAUDE_CODE_HIDE_ACCOUNT_INFO": "true",
    "DISABLE_TELEMETRY": "true",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5",
    "FORCE_AUTOUPDATE_PLUGINS": "true",
    "CLAUDE_CODE_ENABLE_TASKS": "true",
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "true",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "true",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(basedpyright:*)",
      "Bash(mypy:*)",
      "Bash(pyright:*)",
      "Bash(ruff:*)",
      "Bash(pytest:*)",
      "Bash(uv:*)",
      "Bash(go:*)",
      "Bash(gofumpt:*)",
      "Bash(goimports:*)",
      "Bash(golangci-lint:*)",
      "Bash(pnpm:*)",
      "Bash(vitest:*)",
      "Bash(tsc:*)",
      "Bash(eslint:*)",
      "Bash(prettier:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(kubectl:*)",
      "Bash(helm:*)",
      "Bash(kind:*)",
      "Bash(stern:*)",
      "Bash(terraform:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(make:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(mkdir:*)",
      "Bash(cat:*)",
      "Bash(bat:*)",
      "Bash(eza:*)",
      "Bash(delta:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(curl:*)",
      "Bash(wc:*)",
      "Bash(tree:*)",
      "Edit",
      "Glob",
      "Grep",
      "NotebookEdit",
      "Read",
      "WebFetch",
      "WebSearch",
      "Write",
      "LSP"
    ],
    "deny": [],
    "defaultMode": "auto"
  },
  "enableAllProjectMcpServers": true,
  "skillOverrides": {
    "batch": "user-invocable-only",
    "claude-api": "user-invocable-only",
    "dataviz": "user-invocable-only",
    "debug": "user-invocable-only",
    "design": "user-invocable-only",
    "design-sync": "user-invocable-only",
    "doctor": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "init": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "loop": "user-invocable-only",
    "run": "user-invocable-only",
    "run-skill-generator": "user-invocable-only",
    "schedule": "user-invocable-only",
    "security-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "update-config": "user-invocable-only",
    "verify": "user-invocable-only",
    "workflow-authoring": "user-invocable-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/.claude/scripts/patch-gopls-lsp.sh\""
          }
        ]
      },
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/.claude/scripts/compact-anchor.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/dotfiles/.claude/scripts/lint_digest.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/.claude/scripts/guard-bash.sh\"",
            "timeout": 30,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/.claude/scripts/guard-docs.sh\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/.claude/scripts/guard-generated.sh\"",
            "timeout": 30,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/.claude/scripts/guard-suppressions.sh\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/.claude/scripts/guard-sensitive.sh\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/.claude/scripts/edit-lint.sh\"",
            "timeout": 90
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch|mcp__web-fetch__.*|mcp__web-search__.*|mcp__grep-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/dotfiles/.claude/scripts/web_scan.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/dotfiles/.claude/scripts/statusline.sh\"",
    "padding": 0
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@chrome-devtools-plugins": true,
    "basedpyright@claude-code-lsps": true,
    "gopls@claude-code-lsps": true,
    "vtsls@claude-code-lsps": true,
    "webapp-testing@awesome-claude-skills": false,
    "github-automation@awesome-claude-skills": false,
    "slack-automation@awesome-claude-skills": false,
    "sentry-automation@awesome-claude-skills": false,
    "datadog-automation@awesome-claude-skills": false,
    "codex@openai-codex": true,
    "context7@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "terraform-skill@antonbabenko": true
  },
  "extraKnownMarketplaces": {
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    },
    "claude-code-lsps": {
      "source": {
        "source": "github",
        "repo": "Piebald-AI/claude-code-lsps"
      }
    },
    "antonbabenko": {
      "source": {
        "source": "github",
        "repo": "antonbabenko/agent-plugins"
      }
    }
  },
  "outputStyle": "default",
  "viewMode": "verbose",
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "autoCompactWindow": 200000,
  "prefersReducedMotion": true,
  "autoDreamEnabled": false,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "verbose": true,
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": true,
  "showTurnDuration": true,
  "terminalProgressBarEnabled": true,
  "showThinkingHint": true,
  "skipWorkflowUsageWarning": true
}
