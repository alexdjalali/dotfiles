# Gmail Account Configuration Template
# Copy this to ~/.neomutt/account.gmail and fill in your details.
#
# The app password lives in the macOS Keychain, never in a file. Store it once
# (security prompts for the password):
#   security add-generic-password -s neomutt-gmail -a your-email@gmail.com -w

set from = "your-email@gmail.com"
set realname = "Your Name"

# IMAP Configuration
set imap_user = "your-email@gmail.com"
set imap_pass = "`security find-generic-password -s neomutt-gmail -a your-email@gmail.com -w`"
set folder = "imaps://imap.gmail.com:993"
set spoolfile = "+INBOX"
set postponed = "+[Gmail]/Drafts"
set record = "+[Gmail]/Sent Mail"
set trash = "+[Gmail]/Trash"

# SMTP Configuration
set smtp_url = "smtps://your-email@gmail.com@smtp.gmail.com:465"
set smtp_pass = "`security find-generic-password -s neomutt-gmail -a your-email@gmail.com -w`"

# Mailboxes to show in sidebar
mailboxes =INBOX =[Gmail]/Sent\ Mail =[Gmail]/Drafts =[Gmail]/Spam =[Gmail]/Trash =[Gmail]/All\ Mail

# Folder macros (re-bound whenever this account is sourced)
macro index,pager gi "<change-folder>=INBOX<enter>" "Go to Inbox"
macro index,pager gs "<change-folder>=[Gmail]/Sent Mail<enter>" "Go to Sent"
macro index,pager gd "<change-folder>=[Gmail]/Drafts<enter>" "Go to Drafts"
macro index,pager gt "<change-folder>=[Gmail]/Trash<enter>" "Go to Trash"
macro index,pager ga "<change-folder>=[Gmail]/All Mail<enter>" "Go to All Mail"
# Archive: remove from Inbox, keep in All Mail
macro index,pager A "<save-message>=[Gmail]/All Mail<enter>" "Archive message"
